{:aliases {:dev       {:extra-deps  {io.github.nubank/morse {:git/sha "d99b09c"
                                                             :git/tag
                                                             "v2023.04.30.01"}}
                       :extra-paths ["dev"]}
           :test      {:extra-deps {lambdaisland/kaocha         {:mvn/version
                                                                 "1.91.1392"}
                                    nubank/matcher-combinators  {:mvn/version
                                                                 "3.9.2"}
                                    pjstadig/humane-test-output {:mvn/version
                                                                 "0.11.0"}
                                    vvvvalvalval/scope-capture  {:mvn/version
                                                                 "0.3.3"}}
                       :extra-paths ["test"]
                       :jvm-opts ["--add-opens=java.base/java.nio=ALL-UNNAMED"
                                  "-Dio.netty.tryReflectionSetAccessible=true"]
                       :main-opts ["-m" "kaocha.runner"]}
           :watch     {:exec-args {:watch? true}
                       :exec-fn   kaocha.runner/exec-fn}
           ;; This alias is useful if you need to develop a new hook for a
           ;; macro
           :clj-kondo {:extra-deps {clj-kondo/clj-kondo {:mvn/version
                                                         "LATEST"}}}
           :build     {:extra-deps {io.github.clojure/tools.build {:mvn/version
                                                                   "0.9.6"}}
                       :ns-default build}}
 ;; Tram is batteries-included: reitit, malli, integrant, toucan2,
 ;; honeysql, next.jdbc, migratus, buddy, telemere and friends arrive with
 ;; it. Only add a dep here if Tram does not already bring it.
 :deps    {bolivier/tram        {:git/sha
                                 "939165fd1088b779617241cb3b06fbd4312bad5c"

                                 :git/url "https://github.com/bolivier/tram"}
           enlive/enlive        {:mvn/version "1.1.6"}
           meander/epsilon      {:mvn/version "0.0.650"}
           org.clojure/clojure  {:mvn/version "1.12.0"}
           org.clojure/data.xml {:mvn/version "0.2.0-alpha6"}}
 :paths   ["src" "resources"]}
