#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "$0")/.."

# nrepl and cider-nrepl arrive with Tram, so this needs no extra deps. Writes
# .nrepl-port, which editors and the clojure-mcp server in .mcp.json read.
exec clojure -M:dev:test -m nrepl.cmdline \
  --middleware '[cider.nrepl/cider-middleware]' \
  "$@"
