;; SQLite needs no server, so a database is just a file under db/. Tram teaches
;; Toucan2 the SQLite dialect in tram.db.sqlite, which tram.db loads for you.
{:database/development {:db            {:dbname "db/development.db"
                                        :dbtype "sqlite"}
                        :init-script   "init.sql"
                        :migration-dir "migrations/"
                        :migration-table-name "migrations"
                        :store         :database}
 :database/production  {:db            {:dbname "db/production.db"
                                        :dbtype "sqlite"}
                        :init-script   "init.sql"
                        :migration-dir "migrations/"
                        :migration-table-name "migrations"
                        :store         :database}
 :database/test        {:db            {:dbname "db/test.db"
                                        :dbtype "sqlite"}
                        :init-script   "init.sql"
                        :migration-dir "migrations/"
                        :migration-table-name "migrations"
                        :store         :database}
 :project/name         :tram-docs}
