-- allium: 3
-- rhizome.allium

-- Scope: the rhizome client runtime as the code behaves today.
-- Includes: directives, triggers, the debounce modifier, behaviors, bindings, signals, mount,
--   commands, server round trips, response handling, stream consumption, directive encoding.
-- Excludes:
--   - The hiccup to html encoder in rhizome.html, apart from directive encoding.
--   - The server's stream source and emitter internals. Only the stream event contract is kept.
--   - Logging, console output, and dev tooling.
-- Where the code departs from CONTEXT.md, an open question records it.

given {
    page: Page
}

------------------------------------------------------------
-- External Entities
------------------------------------------------------------

external entity Page {
    csrf_token: String?
}

external entity Element {
    id: String?
    text: String
    hidden: Boolean
    classes: Set<String>
    control_value: Value?
    form: Form?
}

external entity Form {}

external entity DomEvent {
    type: DomEventType
    default_prevented: Boolean
}

external entity Value {}

external entity Server {}

external entity Application {}

external entity Response {
    was_redirected: Boolean
    final_url: String
    is_stream: Boolean
    body_html: String
}

external entity StreamEvent {
    stream: Stream
    command_key: String?
    arguments: String?
}

------------------------------------------------------------
-- Value Types
------------------------------------------------------------

value Expression {
    reads: Set<String>
}

value Payload {
    command: Value?
    debounce: Duration?
    expression: Expression?
    class_name: String?
    signal_name: String?
    initial_value: Value?
}

value FormFields {}

value SelectedFile {
    control_name: String
}

value RequestBody {
    fields: FormFields
    files: Set<SelectedFile>

    is_multipart: files.count > 0
}

------------------------------------------------------------
-- Contracts
------------------------------------------------------------

contract DirectiveEncoding {
    attribute_name: (key: String) -> String
    encode_payload: (payload: Any) -> String
    decode_payload: (text: String) -> Any

    @invariant SharedNamingRule
        -- Server render and client mount derive an attribute name from a directive key by one rule.
        -- Mount finds an attribute by encoding the behavior's key, never by decoding a name.

    @invariant PayloadIsEdn
        -- A map or vector payload is written as edn and read back as edn.
        -- decode_payload(encode_payload(p)) = p for those payloads.

    @invariant EmptyPayloadOmitted
        -- A nil, false, or empty payload writes no attribute.
}

contract StreamEventProtocol {
    next_event: (stream: Stream) -> StreamEvent

    @invariant EventNamesACommand
        -- Every stream event names one command key.
        -- It carries that command's arguments as one edn map, without the key.

    @invariant ContentArrivesAsHtml
        -- The server renders any view or content in a stream event before sending it.
        -- It renders as a partial. The client never receives hiccup.

    @invariant KeepAliveCarriesNoCommand
        -- An idle stream gets a keep-alive every 25 seconds. A keep-alive names no command.

    @invariant EventsInSourceOrder
        -- Stream events arrive in the order the stream source yields them.

    @invariant RenderFailureDropsOneEvent
        -- A stream event that fails to render is not sent. The stream stays open.

    @invariant StreamEndsWhenSourceSpent
        -- The server ends the stream once the stream source is spent or fails.
        -- The client treats a failure and a completion alike.
}

------------------------------------------------------------
-- Enumerations
------------------------------------------------------------

enum DomEventType { click | submit | input | drop | dragover }

enum BehaviorKind {
    event_trigger | mount_trigger | text_binding | show_binding | class_binding
    | two_way_binding | signal_inspector
}

enum HttpMethod { get | post | patch }

enum CommandOrigin { directive | stream_event | response_handling }

enum FailureKind {
    unparseable_payload | invalid_expression | unregistered_command | unplaced_response_element
    | unreadable_stream_event | command_failed | network_failure
}

------------------------------------------------------------
-- Entities and Variants
------------------------------------------------------------

entity Runtime {
    status: idle | started

    transitions status {
        idle -> started
        terminal: started
    }
}

entity Behavior {
    attribute: String
    kind: BehaviorKind
    listens_for: DomEventType?

    evaluates_expression: kind in { text_binding, show_binding, class_binding }
}

entity Directive {
    element: Element
    behavior: Behavior
    status: pending | mounted | rejected
    payload_at_mount: Payload when status = mounted
    debounce_due_at: Timestamp?
    debounced_event: DomEvent?
    debounced_payload: Payload?

    listeners: SignalListener with directive = this

    transitions status {
        pending -> mounted
        pending -> rejected
        terminal: mounted, rejected
    }
}

entity Signal {
    name: String
    value: Value?

    listeners: SignalListener with signal = this
}

entity SignalListener {
    signal: Signal
    directive: Directive
}

entity CommandDefinition {
    key: String
}

entity Command {
    key: String
    origin: CommandOrigin
    element: Element?
    dom_event: DomEvent?
    kind: HttpCommand | MorphCommand | NavigateCommand | RemoveCommand | PreventDefaultCommand | ApplicationCommand
}

variant HttpCommand : Command {
    method: HttpMethod
    url: String
}

variant MorphCommand : Command {
    content: String
}

variant NavigateCommand : Command {
    url: String
}

variant RemoveCommand : Command {
    target_id: String
}

variant PreventDefaultCommand : Command {}

variant ApplicationCommand : Command {}

entity Request {
    command: HttpCommand
    method: HttpMethod
    url: String
    asks_for_partial: Boolean
    body: RequestBody?
    carries_csrf_token: Boolean
    carries_signals: Boolean
    status: in_flight | answered | failed

    transitions status {
        in_flight -> answered
        in_flight -> failed
        terminal: answered, failed
    }
}

entity Stream {
    response: Response
    opened_by: Request
    status: open | closed | broken | aborted

    transitions status {
        open -> closed
        open -> broken
        open -> aborted
        terminal: closed, broken, aborted
    }
}

entity Failure {
    kind: FailureKind
    element: Element?
    command: Command?
    stream_event: StreamEvent?
    request: Request?
}

------------------------------------------------------------
-- Config
------------------------------------------------------------

config {
    expression_allowlist: Set<String> = {
        "signal", "not", "=", "not=", "<", ">", "<=", ">=",
        "count", "empty?", "seq", "nil?", "some?", "str", "boolean"
    }
    short_circuit_forms: Set<String> = { "and", "or", "if" }
}

------------------------------------------------------------
-- Defaults
------------------------------------------------------------

default Runtime runtime = { status: idle }

default Behavior click_behavior = { attribute: "click", kind: event_trigger, listens_for: click }
default Behavior submit_behavior = { attribute: "submit", kind: event_trigger, listens_for: submit }
default Behavior input_behavior = { attribute: "input", kind: event_trigger, listens_for: input }
default Behavior drop_behavior = { attribute: "drop", kind: event_trigger, listens_for: drop }
default Behavior dragover_behavior = { attribute: "dragover", kind: event_trigger, listens_for: dragover }
default Behavior load_behavior = { attribute: "load", kind: mount_trigger }
default Behavior text_behavior = { attribute: "text", kind: text_binding }
default Behavior show_behavior = { attribute: "show", kind: show_binding }
default Behavior class_behavior = { attribute: "class", kind: class_binding }
default Behavior bind_behavior = { attribute: "bind", kind: two_way_binding, listens_for: input }
default Behavior debug_behavior = { attribute: "debug", kind: signal_inspector }

------------------------------------------------------------
-- Rules
------------------------------------------------------------

-- Registration

rule BehaviorAdded {
    when: ApplicationRegistersBehavior(attribute, kind, listens_for?)
    let existing = Behavior{attribute}
    ensures:
        if exists existing:
            not exists existing
        Behavior.created(attribute: attribute, kind: kind, listens_for: listens_for)
}

rule CommandDefinitionAdded {
    when: ApplicationRegistersCommand(key)
    requires: not exists CommandDefinition{key}
    ensures: CommandDefinition.created(key: key)
}

-- Mount

rule DirectiveArrives {
    when: ElementCarriesDirective(element, behavior)
    requires: not exists Directive{element, behavior}
    ensures: Directive.created(element: element, behavior: behavior, status: pending)
}

rule RhizomeStarts {
    when: PageLoaded()
    requires: runtime.status = idle
    ensures:
        runtime.status = started
        for directive in Directives where status = pending:
            MountRequested(directive: directive)

    @guidance
        -- Bindings first apply once every directive in the scan has mounted, so each signal holds its seed.
}

rule AddedSubtreeMounts {
    when: SubtreeAdded(root)
    requires: runtime.status = started
    for directive in Directives where status = pending and inside(element, root):
        ensures: MountRequested(directive: directive)
}

rule DirectiveMounted {
    when: MountRequested(directive)
    requires: directive.status = pending
    let payload = parse_payload(directive)
    requires: payload != null
    requires:
        not directive.behavior.evaluates_expression
        or well_formed(payload.expression, config.expression_allowlist, config.short_circuit_forms)
    ensures:
        directive.status = mounted
        directive.payload_at_mount = payload

    @guidance
        -- well_formed: each signal read names one literal signal. Each call head is allowlisted or short-circuits.
}

rule UnparseablePayloadRejected {
    when: MountRequested(directive)
    requires: directive.status = pending
    requires: parse_payload(directive) = null
    ensures:
        directive.status = rejected
        Failure.created(kind: unparseable_payload, element: directive.element)
}

rule InvalidExpressionRejected {
    when: MountRequested(directive)
    requires: directive.status = pending
    let payload = parse_payload(directive)
    requires: payload != null
    requires: directive.behavior.evaluates_expression
    requires: not well_formed(payload.expression, config.expression_allowlist, config.short_circuit_forms)
    ensures:
        directive.status = rejected
        Failure.created(kind: invalid_expression, element: directive.element)
}

-- Unmount

rule RemovedSubtreeUnmounts {
    when: SubtreeRemoved(root)
    for directive in Directives where inside(element, root):
        ensures: UnmountRequested(directive: directive)
}

rule DirectiveUnmounted {
    when: UnmountRequested(directive)
    ensures:
        for listener in directive.listeners:
            not exists listener
        not exists directive

    @guidance
        -- Removing the directive drops its dom listener and cancels its pending debounced run.
        -- The signals it read keep their values, so an element a morph brings back finds them intact.
}

rule RemovedSubtreeAbortsStreams {
    when: SubtreeRemoved(root)
    for stream in Streams where status = open and opened_by.command.element != null and inside(opened_by.command.element, root):
        ensures: stream.status = aborted
}

-- Triggers and the debounce modifier

rule MountTriggerFires {
    when: directive: Directive.status becomes mounted
    requires: directive.behavior.kind = mount_trigger
    ensures: CommandRuns(command: command_from(directive.payload_at_mount.command, directive.element, null))

    @guidance
        -- A morph that brings back an element carrying this directive mounts it and runs it again.
}

rule TriggerFires {
    when: DomEventDispatched(target, event)
    for directive in Directives where element = target and status = mounted and behavior.listens_for = event.type:
        let payload = parse_payload(directive)
        ensures:
            if payload = null:
                Failure.created(kind: unparseable_payload, element: directive.element)
            else if payload.debounce > 0.seconds:
                DebounceStarted(directive: directive, event: event, payload: payload)
            else:
                DirectiveRuns(directive: directive, event: event, payload: payload)

    @guidance
        -- The payload is read again at trigger time, because a morph can rewrite it on an element it keeps.
}

rule DebounceWindowOpens {
    when: DebounceStarted(directive, event, payload)
    ensures:
        event.default_prevented = true
        directive.debounce_due_at = now + payload.debounce
        directive.debounced_event = event
        directive.debounced_payload = payload

    @guidance
        -- The dom event is spent before the window ends, so its default is prevented at once.
}

rule DebounceWindowElapses {
    when: directive: Directive.debounce_due_at <= now
    requires: directive.debounce_due_at != null
    ensures:
        directive.debounce_due_at = null
        DirectiveRuns(directive: directive, event: directive.debounced_event, payload: directive.debounced_payload)
}

rule EventTriggerRuns {
    when: DirectiveRuns(directive, event, payload)
    requires: directive.behavior.kind = event_trigger
    ensures: CommandRuns(command: command_from(payload.command, directive.element, event))
}

-- Bindings

rule BindingMounted {
    when: directive: Directive.status becomes mounted
    requires: directive.behavior.evaluates_expression
    let expression = directive.payload_at_mount.expression
    ensures:
        if expression.reads.count = 0:
            BindingReapplied(directive: directive)
        for name in expression.reads:
            SignalListened(name: name, directive: directive)
}

rule TwoWayBindingMounted {
    when: directive: Directive.status becomes mounted
    requires: directive.behavior.kind = two_way_binding
    let payload = directive.payload_at_mount
    ensures:
        SignalListened(name: payload.signal_name, directive: directive)
        SignalWritten(name: payload.signal_name, value: payload.initial_value)
}

rule TwoWayBindingFollowsControl {
    when: DirectiveRuns(directive, event, payload)
    requires: directive.behavior.kind = two_way_binding
    ensures: SignalWritten(name: payload.signal_name, value: directive.element.control_value)
}

rule SignalInspectorMounted {
    when: directive: Directive.status becomes mounted
    requires: directive.behavior.kind = signal_inspector
    ensures: directive.element.text = render_values(Signals)
}

rule TextBindingReapplied {
    when: BindingReapplied(directive)
    requires: directive.behavior.kind = text_binding
    ensures: directive.element.text = as_text(evaluate(directive.payload_at_mount.expression))
}

rule ShowBindingReapplied {
    when: BindingReapplied(directive)
    requires: directive.behavior.kind = show_binding
    ensures: directive.element.hidden = not truthy(evaluate(directive.payload_at_mount.expression))

    @guidance
        -- Showing hands display back to the stylesheet rather than forcing a value.
}

rule ClassBindingReapplied {
    when: BindingReapplied(directive)
    requires: directive.behavior.kind = class_binding
    let payload = directive.payload_at_mount
    ensures:
        if truthy(evaluate(payload.expression)):
            directive.element.classes.add(payload.class_name)
        else:
            directive.element.classes.remove(payload.class_name)
}

rule TwoWayBindingReapplied {
    when: BindingReapplied(directive)
    requires: directive.behavior.kind = two_way_binding
    let signal = Signal{name: directive.payload_at_mount.signal_name}
    ensures: directive.element.control_value = signal.value

    @guidance
        -- A checkbox follows truthiness. A file control can only be cleared.
}

-- Signals

rule ListenerJoinsSignal {
    when: SignalListened(name, directive)
    let signal = Signal{name}
    ensures:
        if not exists signal:
            Signal.created(name: name, value: null)
        SignalListener.created(signal: Signal{name}, directive: directive)
        BindingReapplied(directive: directive)
}

rule SignalUpdated {
    when: SignalWritten(name, value)
    let signal = Signal{name}
    ensures:
        if exists signal:
            signal.value = value
            for listener in signal.listeners:
                BindingReapplied(directive: listener.directive)
        else:
            Signal.created(name: name, value: value)
}

rule SignalInspectorRefreshes {
    when: SignalWritten(name, value)
    for inspector in Directives where status = mounted and behavior.kind = signal_inspector:
        ensures: inspector.element.text = render_values(Signals)
}

-- Commands

rule HttpCommandSendsRequest {
    when: CommandRuns(command)
    requires: command.kind = HttpCommand
    let form = command.element?.form
    let sends_body = command.method != get and form != null
    ensures:
        if command.dom_event != null:
            command.dom_event.default_prevented = true
        Request.created(
            command: command,
            method: command.method,
            url: command.url,
            asks_for_partial: true,
            body: if sends_body: form_body(form) else: null,
            carries_csrf_token: command.method != get and page.csrf_token != null,
            carries_signals: false,
            status: in_flight
        )

    @guidance
        -- form_body holds the form's submittable fields and the files chosen in its file controls.
        -- An element outside any form sends no body, even on post or patch.
}

rule PartialMorphed {
    when: CommandRuns(command)
    requires: command.kind = MorphCommand
    ensures:
        for element in top_level_elements(command.content):
            let target = Element{id: element.id}
            if exists target:
                PageElementMorphed(target: target, replacement: element)
            else:
                Failure.created(kind: unplaced_response_element, command: command)

    @guidance
        -- top_level_elements ignores text and comments. An element with no id matches nothing.
        -- One dropped element does not stop the rest.
}

rule MorphReportsSubtreeChanges {
    when: PageElementMorphed(target, replacement)
    ensures:
        for root in added_subtrees(target, replacement):
            SubtreeAdded(root: root)
        for root in removed_subtrees(target, replacement):
            SubtreeRemoved(root: root)

    @guidance
        -- The target is replaced whole, attributes included, while its children are diffed.
}

rule PageNavigated {
    when: CommandRuns(command)
    requires: command.kind = NavigateCommand
    ensures: FullPageLoadRequested(url: command.url)
}

rule ElementRemoved {
    when: CommandRuns(command)
    requires: command.kind = RemoveCommand
    let target = Element{id: command.target_id}
    ensures:
        if exists target:
            not exists target
            SubtreeRemoved(root: target)
}

rule DefaultPrevented {
    when: CommandRuns(command)
    requires: command.kind = PreventDefaultCommand
    requires: command.dom_event != null
    ensures: command.dom_event.default_prevented = true
}

rule ApplicationCommandRan {
    when: CommandRuns(command)
    requires: command.kind = ApplicationCommand
    requires: exists CommandDefinition{key: command.key}
    ensures: CommandDefinitionRan(command: command)
}

rule UnregisteredCommandReported {
    when: CommandRuns(command)
    requires: command.kind = ApplicationCommand
    requires: not exists CommandDefinition{key: command.key}
    ensures: Failure.created(kind: unregistered_command, command: command, element: command.element)
}

rule CommandFailureReported {
    when: CommandFailed(command)
    ensures: Failure.created(kind: command_failed, command: command, element: command.element)

    @guidance
        -- A failed command stops alone. The commands after it in a directive or a stream still run.
}

-- Server round trips

rule ResponseHandled {
    when: ResponseArrived(request, response)
    requires: request.status = in_flight
    ensures:
        request.status = answered
        if response.was_redirected:
            CommandRuns(command: NavigateCommand.created(key: "dom/navigate", origin: response_handling, url: response.final_url))
        else if response.is_stream and request.command.element != null and not on_page(request.command.element):
            Stream.created(response: response, opened_by: request, status: aborted)
        else if response.is_stream:
            Stream.created(response: response, opened_by: request, status: open)
        else:
            CommandRuns(command: MorphCommand.created(key: "dom/morph", origin: response_handling, content: response.body_html))

    @guidance
        -- The response decides, not the element. Any endpoint may stream.
        -- A redirect wins over a stream. Every other response morphs, whatever its outcome or media type.
        -- A request whose element has left the page still completes, because its response targets by id.
}

rule RequestFailed {
    when: RequestLostInTransit(request)
    requires: request.status = in_flight
    ensures:
        request.status = failed
        Failure.created(kind: network_failure, request: request, element: request.command.element)
}

-- Streams

rule StreamEventApplied {
    when: StreamEventReceived(event)
    requires: event.stream.status = open
    requires: event.command_key != null and event.arguments != null
    requires: is_edn_map(event.arguments)
    ensures: CommandRuns(command: command_from_stream_event(event))

    @guidance
        -- A stream event's command has no element and no dom event.
}

rule StreamEventDropped {
    when: StreamEventReceived(event)
    requires: event.stream.status = open
    requires: event.command_key != null and event.arguments != null
    requires: not is_edn_map(event.arguments)
    ensures: Failure.created(kind: unreadable_stream_event, stream_event: event)

    @guidance
        -- One stream event is lost and the stream stays open.
}

rule StreamEnded {
    when: StreamClosedByServer(stream)
    requires: stream.status = open
    ensures: stream.status = closed

    @guidance
        -- A stream event cut off by the close is discarded, never run.
}

rule StreamBroken {
    when: StreamConnectionLost(stream)
    requires: stream.status = open
    ensures:
        stream.status = broken
        Failure.created(kind: network_failure, request: stream.opened_by, element: stream.opened_by.command.element)

    @guidance
        -- Nothing reconnects. A dropped stream stays dropped until a trigger runs again.
}

------------------------------------------------------------
-- Invariants
------------------------------------------------------------

invariant OneBehaviorPerAttribute {
    for a in Behaviors:
        for b in Behaviors:
            a != b implies a.attribute != b.attribute
}

invariant OneDirectivePerBehaviorPerElement {
    for a in Directives:
        for b in Directives:
            a != b and a.element = b.element implies a.behavior != b.behavior
}

invariant OneSignalPerName {
    for a in Signals:
        for b in Signals:
            a != b implies a.name != b.name
}

invariant OnlyListeningBehaviorsHaveAnEvent {
    for b in Behaviors:
        b.listens_for != null implies b.kind in { event_trigger, two_way_binding }
}

invariant OnlyMountedEventTriggersDebounce {
    for d in Directives:
        d.debounce_due_at != null implies d.status = mounted and d.behavior.kind = event_trigger
}

invariant NoOpenStreamOutlivesItsElement {
    for s in Streams:
        s.status = open and s.opened_by.command.element != null
            implies on_page(s.opened_by.command.element)
}

invariant EveryRequestAsksForPartial {
    for r in Requests:
        r.asks_for_partial = true
}

invariant GetSendsNoBodyAndNoToken {
    for r in Requests:
        r.method = get implies r.body = null and not r.carries_csrf_token
}

------------------------------------------------------------
-- Actor Declarations
------------------------------------------------------------

actor Visitor {
    identified_by: Page where true
}

actor Developer {
    identified_by: Application where true
}

actor TramServer {
    identified_by: Server where true
}

------------------------------------------------------------
-- Surfaces
------------------------------------------------------------

surface PageInteraction {
    facing visitor: Visitor
    context element: Element

    exposes:
        element.text
        element.hidden
        element.classes
        element.control_value

    provides:
        PageLoaded()
        ElementCarriesDirective(element, behavior)
        DomEventDispatched(element, event)

    @guarantee MountOrderFree
        -- The page after a mount scan does not depend on the order its directives mount.
}

surface RhizomeExtension {
    facing developer: Developer

    provides:
        ApplicationRegistersBehavior(attribute, kind, listens_for?)
        ApplicationRegistersCommand(key)
        CommandFailed(command)
}

surface FailureReporting {
    facing developer: Developer
    context failure: Failure

    exposes:
        failure.kind
        failure.element
        failure.command
        failure.stream_event
        failure.request

    @guarantee EveryFailureReachesTheSink
        -- Every failure reaches the error sink as a Failure. Nothing throws past the sink.

    @guarantee FailuresStayLocal
        -- A failure stops only its own directive, command, stream event, or response element.

    @guidance
        -- The application supplies the error sink when rhizome starts. The default sink writes to the console.
}

surface RhizomeRoundTrip {
    facing server: TramServer
    context request: Request

    exposes:
        request.method
        request.url
        request.asks_for_partial
        request.body when request.method != get
        request.carries_csrf_token

    provides:
        ResponseArrived(request, response)
        RequestLostInTransit(request)

    contracts:
        demands DirectiveEncoding
        demands StreamEventProtocol
}

surface StreamDelivery {
    facing server: TramServer
    context stream: Stream where status = open

    provides:
        StreamEventReceived(event)
        StreamClosedByServer(stream)
        StreamConnectionLost(stream)

    contracts:
        demands StreamEventProtocol
}

------------------------------------------------------------
-- Open Questions
------------------------------------------------------------

-- Mount and unmount
open question "A morph that keeps an element never mounts directives it adds there. A removed event trigger keeps listening. A binding keeps its mount-time payload."

-- Triggers and modifiers
open question "The mount trigger is a behavior named load, which collides with the dom load event. CONTEXT names it ::on/mount."
open question "Debounce is the only modifier. CONTEXT also names once. Are key, prevent, stop, and throttle wanted?"
open question "The trigger set is closed to five dom events. Should any trigger name pass through, so an application can add custom events?"
open question "An event trigger's payload is one command map with modifiers mixed in. Should it be a vector of commands, with modifiers beside it?"
open question "prevent-default is a command that fails when no dom event exists, as from a stream or the mount trigger. Should it be a modifier?"

-- Bindings and signals
open question "Two controls that seed one signal with different values make mount order matter. Which seed wins? A missing seed blanks the signal."
open question "A signal write notifies every listener even when the value is unchanged. Intended?"
open question "A bare symbol in argument position evaluates to itself. Should a bare symbol read a signal, with anything unknown failing at mount?"
open question "A class binding toggles one class per directive. Should it take a map from class to predicate?"
open question "Can an application extend the expression allowlist?"
open question "The signal inspector ships in the default behavior set. Should a debug tool be a default?"

-- Commands and the registry
open question "Commands dispatch through a multimethod keyed on :do. CONTEXT keys a command on :command. Should a command definition carry lifecycle fns and a schema checked at mount?"
open question "Only get, post, and patch ship. Are put, delete, and a signal-setting command wanted?"
open question "remove requires an id. Should it default to the directive's own element?"
open question "Morph searches the whole document. Should the search start from the directive's root node, so morph works inside shadow roots?"

-- Server round trips
open question "Requests carry the enclosing form's fields, never signals. CONTEXT says every request carries the signals. Should signals replace form scraping?"
open question "Should an edn response patch signals, as a third response kind beside partial and stream?"
open question "Every response that is not a redirect or a stream morphs, failures and unknown media types included. Should either morph?"
